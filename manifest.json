{
  "manifest_version": 3,
  "name": "Miner - Toplu PDF İndirici",
  "version": "1.1",
  "description": "GİB, SGK E-Bildirge ve E-Beyanname portallarından toplu PDF indirme aracı. Beyanname, tahakkuk ve hizmet belgelerini otomatik klasörleyerek indirir. Destek: nuh@ziyahanbasar.com",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "inject.js"
      ],
      "all_frames": true,
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["<all_urls>"]
    }
  ]
}